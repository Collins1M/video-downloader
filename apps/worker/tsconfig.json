{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "declaration": false,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@video-downloader/types": ["./../../packages/types/src"],
      "@video-downloader/config": ["./../../packages/config/src"],
      "@video-downloader/database": ["./../../packages/database/src"],
      "@video-downloader/security": ["./../../packages/security/src"],
      "@video-downloader/media-extractor": ["./../../packages/media-extractor/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.ts", "dist", "node_modules"]
}
