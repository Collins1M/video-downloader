{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@video-downloader/types": ["../../packages/types/src"],
      "@video-downloader/config": ["../../packages/config/src"],
      "@video-downloader/database": ["../../packages/database/src"],
      "@video-downloader/security": ["../../packages/security/src"],
      "@video-downloader/media-extractor": ["../../packages/media-extractor/src"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
