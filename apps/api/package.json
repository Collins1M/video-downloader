{
  "name": "@video-downloader/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/throttler": "^6.0.0",
    "@sentry/node": "^8.30.0",
    "@video-downloader/database": "*",
    "@video-downloader/media-extractor": "*",
    "@video-downloader/security": "*",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@video-downloader/types$": "<rootDir>/../../../packages/types/src",
      "^@video-downloader/database$": "<rootDir>/../../../packages/database/src",
      "^@video-downloader/security$": "<rootDir>/../../../packages/security/src",
      "^@video-downloader/media-extractor$": "<rootDir>/../../../packages/media-extractor/src"
    }
  }
}
