{
  "name": "video-downloader-backend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:worker": "npm run start:dev --workspace=apps/worker",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "build:packages": "npm run build --workspace=packages/types && npm run build --workspace=packages/config && npm run build --workspace=packages/security && npm run build --workspace=packages/database && npm run build --workspace=packages/media-extractor",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=apps/api && npm run typecheck --workspace=apps/worker",
    "test": "npm run test --workspace=packages/security && npm run test --workspace=packages/media-extractor && npm run test --workspace=apps/worker && npm run test --workspace=apps/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "prisma": "^6.4.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@prometheus-io/client": "^0.16.1",
    "@sentry/conventions": "^0.16.0",
    "@sentry/core": "^10.72.0",
    "@sentry/node-core": "^10.72.0",
    "@sentry/opentelemetry": "^10.72.0",
    "@sentry/server-utils": "^10.72.0",
    "dotenv": "^17.4.2",
    "es-toolkit": "^1.31.0",
    "estree-walker": "^3.0.3",
    "libphonenumber-js": "^1.11.0",
    "validator": "^13.12.0",
    "lightningcss": "^1.33.0",
    "magic-string": "^1.2.3",
    "obug": "^1.0.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "rolldown": "^1.2.7",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@nestjs/throttler": {
      "@nestjs/common": "^12.0.1",
      "@nestjs/core": "^12.0.1"
    },
    "test-exclude": {
      "glob": "^11.0.0"
    },
    "deepmerge-ts": "^8.0.0",
    "glob": "^13.0.6",
    "rimraf": "^6.0.0",
    "inflight": "^1.0.6",
    "async": "^3.2.6"
  },
  "allowScripts": {
    "prisma": true,
    "msgpackr-extract": true,
    "esbuild": true,
    "@nestjs/core": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "@scarf/scarf": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
