# --- General ---
NODE_ENV=development
PORT=4000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sentry DSNs are non-secret by design (meant to ship in client bundles)
# — leave unset to disable error tracking entirely. Same value used for
# both apps/web (client+server) and apps/api/apps/worker (SENTRY_DSN below).
NEXT_PUBLIC_SENTRY_DSN=
FRONTEND_URL=http://localhost:3000

# --- Database ---
POSTGRES_USER=video_downloader
POSTGRES_PASSWORD=change_me
POSTGRES_DB=video_downloader
DATABASE_URL=postgresql://video_downloader:change_me@postgres:5432/video_downloader

# --- Redis / BullMQ ---
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=2

# --- Temp processing storage (Section 9), shared volume between api and worker ---
TEMP_DIR=/var/tmp/video-downloader

# --- Admin dashboard (Section 22) — required to access /api/admin/* ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# --- Observability (Phase 12) ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Leave unset to disable Sentry entirely — never required to run this app.
SENTRY_DSN=
# Worker's dedicated metrics-only HTTP server (it has no other HTTP surface by design).
METRICS_PORT=9091

# --- Abuse prevention (Section 14) ---
MAX_VIDEO_SIZE_MB=2048
MAX_PROCESSING_TIME_SECONDS=900
MAX_CONCURRENT_JOBS_PER_IP=2
# RATE_LIMIT_PER_MINUTE applies to /video/analyze and file downloads
# ("general" tier). /video/download has its own, stricter limit since
# it's the most expensive operation; job status polling has its own,
# much higher limit since the frontend legitimately polls every ~1.2s
# while a download is active.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_DOWNLOAD_PER_MINUTE=5
RATE_LIMIT_POLLING_PER_MINUTE=120
TEMP_FILE_TTL_MINUTES=30

# --- Job retry (Section 11, reliability) ---
# How many times a transient processing failure (timeout, ambiguous
# yt-dlp/ffmpeg error) is retried before giving up. Permanent failures
# (unsupported source, video unavailable, file too large, blocked URL)
# are never retried regardless of this setting.
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_BACKOFF_MS=15000
