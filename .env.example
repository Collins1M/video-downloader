# --- General ---
NODE_ENV=development
PORT=4000

# --- Frontend (for CORS & reference) ---
FRONTEND_URL=https://download.fplstocks.com

# --- Database ---
DATABASE_URL=postgresql://postgres:user:pass@localhost:5432/video_downloader

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# --- Temp processing storage ---
TEMP_DIR=/var/tmp/video-downloader

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
METRICS_PORT=9091
ANALYZE_TIMEOUT_MS=60000

# --- Job retry ---
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_BACKOFF_MS=15000
